# Path to Oh My Zsh installation
export ZSH="$HOME/.oh-my-zsh"

# Theme
ZSH_THEME="crunch"

# fzf (must be set before oh-my-zsh loads)
unset FZF_BASE
{{- if eq .chezmoi.os "darwin" }}
for _fzf_base in /opt/homebrew/opt/fzf /usr/local/opt/fzf; do
  if [[ -d "$_fzf_base" ]]; then
    export FZF_BASE="$_fzf_base"
    break
  fi
done
{{- else }}
if [[ -d /usr/share/doc/fzf/examples ]]; then
  export FZF_BASE=/usr/share/doc/fzf/examples
fi
{{- end }}

# Plugins
plugins=(git docker kubectl)
if [[ -n "${FZF_BASE:-}" && -d "$FZF_BASE" ]]; then
  plugins+=(fzf)
fi

source $ZSH/oh-my-zsh.sh

# Editor
export EDITOR='emacs'

# -----------------
# PATH additions
# -----------------
export PATH=$PATH:/usr/local/go/bin
export PATH="$HOME/go/bin:$PATH"
export PATH=$PATH:/usr/sbin
export PATH="$HOME/.config/emacs/bin:$PATH"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# depot_tools for Chromium development
export PATH="$HOME/depot_tools:$PATH"

# Local bin
export PATH="$HOME/.local/bin:$PATH"

# npm global packages
# Set the prefix (not just PATH) so `npm install -g` writes here instead of
# falling back to /usr (dirname of /usr/bin/node), which isn't user-writable.
export npm_config_prefix="$HOME/.npm-global"
mkdir -p "$HOME/.npm-global"
export PATH="$HOME/.npm-global/bin:$PATH"

# opencode
export PATH="$HOME/.opencode/bin:$PATH"

# pnpm
export PNPM_HOME="$HOME/.local/share/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac

# -----------------
# Sourced files
# -----------------
[ -f "$HOME/.local/bin/env" ] && . "$HOME/.local/bin/env"

# -----------------
# Custom tools
# -----------------
if command -v try >/dev/null 2>&1; then
  eval "$(try init ~/code/tries)"
fi

# -----------------
# API Keys
# -----------------
export KERNEL_API_KEY={{ onepasswordRead "op://sa/dev/KERNEL_API_KEY" | quote }}
export OPENAI_API_KEY_KERNEL={{ onepasswordRead "op://sa/dev/OPENAI_API_KEY" | quote }}
export GOOGLE_API_KEY_KERNEL={{ onepasswordRead "op://sa/dev/GOOGLE_API_KEY" | quote }}
export OPENROUTER_API_KEY={{ onepasswordRead "op://sa/dev/OPENROUTER_API_KEY" | quote }}
{{- if ne .chezmoi.os "darwin" }}
export OP_SERVICE_ACCOUNT_TOKEN={{ onepasswordRead "op://sa/dev/OP_SERVICE_ACCOUNT_TOKEN" | quote }}
{{- end }}

# -----------------
# Aliases
# -----------------
alias ll='ls -l'
alias la='ls -A'
alias l='ls -CF'
alias ai='opencode run "generate a bash command for $*"'
alias claude='claude --dangerously-skip-permissions'
alias agent='agent --approve-mcps --yolo'
alias codex='codex --dangerously-bypass-approvals-and-sandbox --enable goals'
alias refresh_skills="npx skills add git@github.com:kernel/internal.git --all --agent cursor claude-code --global --yes"

cclaude() {
  if (( $# == 0 )); then
    echo "usage: cclaude <model> [claude args...]" >&2
    return 2
  fi

  local model="$1"
  shift
  local proxy_config="${CLIPROXY_CONFIG:-$HOME/cliproxyapi/config.yaml}"
  local proxy_key
  proxy_key=$(sed -n '/^api-keys:/,/^[^[:space:]]/ s/^[[:space:]]*-[[:space:]]*"\(.*\)"[[:space:]]*$/\1/p' "$proxy_config" | head -n 1)

  if [[ -z "$proxy_key" ]]; then
    echo "could not read a CLIProxyAPI key from $proxy_config" >&2
    return 1
  fi

  ANTHROPIC_BASE_URL="${CLIPROXY_BASE_URL:-http://127.0.0.1:8317}" \
    ANTHROPIC_API_KEY="$proxy_key" \
    command claude --dangerously-skip-permissions --model "$model" "$@"
}

cliproxy-models() {
  local proxy_config="${CLIPROXY_CONFIG:-$HOME/cliproxyapi/config.yaml}"
  local proxy_key
  proxy_key=$(sed -n '/^api-keys:/,/^[^[:space:]]/ s/^[[:space:]]*-[[:space:]]*"\(.*\)"[[:space:]]*$/\1/p' "$proxy_config" | head -n 1)

  if [[ -z "$proxy_key" ]]; then
    echo "could not read a CLIProxyAPI key from $proxy_config" >&2
    return 1
  fi

  curl -fsS \
    -H "Authorization: Bearer $proxy_key" \
    "${CLIPROXY_BASE_URL:-http://127.0.0.1:8317}/v1/models" |
    jq -r '.data[].id' |
    sort -u
}

gws-profile() {
  local profile="$1"
  shift
  if [[ -z "$profile" ]]; then
    echo "usage: gws-profile <profile> [gws args...]" >&2
    return 1
  fi
  GOOGLE_WORKSPACE_CLI_CONFIG_DIR="$HOME/.config/gws-$profile" gws "$@"
}
alias gws-personal='GOOGLE_WORKSPACE_CLI_CONFIG_DIR="$HOME/.config/gws-personal" gws'
alias gws-work='GOOGLE_WORKSPACE_CLI_CONFIG_DIR="$HOME/.config/gws-work" gws'
alias gws-work-legacy='GOOGLE_WORKSPACE_CLI_CONFIG_DIR="$HOME/.config/gws-work-legacy" gws'

# -----------------
# cdc - quick cd to ~/code/kernel
# -----------------
cdc() {
    if [[ -z "$1" ]]; then
        cd ~/code/kernel
    else
        cd ~/code/kernel/"$1"
    fi
}

# Tab completion for cdc
_cdc() {
    local base_dir=~/code/kernel
    _path_files -W "$base_dir" -/
}
compdef _cdc cdc

# Homebrew zsh plugins (loaded directly so oh-my-zsh plugin lookup cannot fail)
if command -v brew >/dev/null 2>&1; then
  _brew_prefix="$(brew --prefix)"
  if [[ -f "$_brew_prefix/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ]]; then
    source "$_brew_prefix/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
  fi
  if [[ -f "$_brew_prefix/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]]; then
    source "$_brew_prefix/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
  fi
fi

# add Pulumi to the PATH
export PATH=$PATH:/home/rgarcia/.pulumi/bin

# >>> Codex installer >>>
export PATH="/home/rgarcia/.local/bin:$PATH"
# <<< Codex installer <<<
